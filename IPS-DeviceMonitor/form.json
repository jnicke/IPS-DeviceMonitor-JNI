{
    "elements": [
        {
            "type": "CheckBox",
            "name": "Active",
            "caption": "Aktiv"
        },
        {
            "type": "CheckBox",
            "name": "UseList",
            "caption": "Liste von Geräten verwenden"
        },
        {
            "type": "Label",
            "label": "Einzelnes Gerät"
        },
        {
            "type": "CheckBox",
            "name": "UseDNS",
            "caption": "DNS-Name verwenden (statt IP-Adresse)"
        },
        {
            "type": "ValidationTextBox",
            "name": "DNSName",
            "caption": "DNS-Name",
            "visible": true
        },
        {
            "type": "ValidationTextBox",
            "name": "IPAddress",
            "caption": "IP-Adresse"
        },
        {
            "type": "Label",
            "label": "Ping-Einstellungen"
        },
        {
            "type": "NumberSpinner",
            "name": "PingTimeout",
            "caption": "Ping Timeout (ms)",
            "minimum": 100,
            "maximum": 10000,
            "suffix": "ms"
        },
        {
            "type": "NumberSpinner",
            "name": "UpdateInterval",
            "caption": "Update Intervall (s)",
            "minimum": 5,
            "maximum": 3600,
            "suffix": "s"
        },
        {
            "type": "CheckBox",
            "name": "UseRetries",
            "caption": "Fehlversuche aktivieren"
        },
        {
            "type": "NumberSpinner",
            "name": "Retries",
            "caption": "Anzahl Versuche",
            "minimum": 1,
            "maximum": 10
        },
        {
            "type": "Label",
            "label": "Host-Liste (wird nur verwendet wenn 'Liste von Geräten verwenden' aktiv ist)"
        },
        {
            "type": "List",
            "name": "HostList",
            "caption": "Geräte",
            "rowCount": 5,
            "add": true,
            "delete": true,
            "columns": [
                {
                    "name": "Name",
                    "caption": "Gerätename",
                    "width": "200px",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "name": "UseDNS",
                    "caption": "DNS verwenden",
                    "width": "100px",
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "name": "DNSName",
                    "caption": "DNS-Name",
                    "width": "200px",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "name": "IPAddress",
                    "caption": "IP-Adresse",
                    "width": "150px",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "name": "MACAddress",
                    "caption": "MAC-Adresse (für WOL)",
                    "width": "150px",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                }
            ]
        },
        {
            "type": "Label",
            "label": "Wake on LAN (nur für einzelnes Gerät)"
        },
        {
            "type": "ValidationTextBox",
            "name": "MACAddress",
            "caption": "MAC-Adresse"
        },
        {
            "type": "ValidationTextBox",
            "name": "BroadcastIP",
            "caption": "Broadcast IP (Standard: 255.255.255.255)"
        }
    ],
    "actions": [
        {
            "type": "Button",
            "label": "Status jetzt aktualisieren",
            "onClick": "DM_UpdateStatus($id);"
        },
        {
            "type": "Button",
            "label": "Wake on LAN senden",
            "onClick": "DM_WakeOnLan($id);"
        }
    ],
    "status": [
        {
            "code": 101,
            "icon": "inactive",
            "caption": "Instanz wird erstellt"
        },
        {
            "code": 102,
            "icon": "active",
            "caption": "Instanz ist aktiv"
        },
        {
            "code": 104,
            "icon": "inactive",
            "caption": "Instanz ist inaktiv"
        },
        {
            "code": 200,
            "icon": "error",
            "caption": "Fehler beim Ping"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "DNS-Auflösung fehlgeschlagen"
        }
    ]
}
